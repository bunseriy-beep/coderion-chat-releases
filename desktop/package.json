{
  "name": "qlinkchat-desktop",
  "version": "1.0.0",
  "description": "QLinkChat — настольное приложение",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.qlinkchat.app",
    "productName": "QLinkChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "icon-512.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "msi"
      ],
      "icon": "icon.ico",
      "sign": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QLinkChat",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "portable": {
      "artifactName": "QLinkChat-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip",
        "pkg"
      ],
      "icon": "icon-512.png",
      "category": "public.app-category.social-networking"
    },
    "dmg": {
      "artifactName": "QLinkChat-${version}.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "icon-512.png",
      "category": "Network"
    },
    "appImage": {
      "artifactName": "QLinkChat-${version}.AppImage"
    },
    "deb": {
      "artifactName": "qlinkchat_${version}_amd64.deb"
    },
    "rpm": {
      "artifactName": "qlinkchat-${version}.x86_64.rpm"
    },
    "tar": {
      "artifactName": "QLinkChat-${version}.tar.gz"
    }
  },
  "author": "bunseriy-beep <bunseriy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunseriy-beep/qlinkchat-releases.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.0.0"
  }
}